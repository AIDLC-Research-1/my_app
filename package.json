{
  "name": "my_app",
  "version": "1.0.0",
  "description": "Simple Node.js TODO REST API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --runInBand",
    "test:unit": "jest test/unit.test.js",
    "test:integration": "jest test/integration.test.js",
    "test:contract": "jest test/contract.test.js",
    "test:security": "jest test/security.test.js",
    "test:coverage": "jest --runInBand --coverage",
    "test:regression": "jest --runInBand --coverage",
    "load-test": "node --expose-gc scripts/load-test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "jest": "^30.4.2",
    "js-yaml": "^4.3.1",
    "supertest": "^7.2.2"
  }
}
