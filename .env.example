# Example environment configuration. Copy to `.env` and adjust as needed.

# Port the HTTP server listens on.
PORT=3000

# Path to the JSON data file. Use ':memory:' to disable persistence.
DATA_FILE=data/todos.json

# Optional API key. When set, requests must send a matching `x-api-key` header.
API_KEY=

# Maximum accepted task length, in characters.
MAX_TASK_LENGTH=500

# Default and maximum page size for GET /todos pagination.
DEFAULT_LIMIT=20
MAX_LIMIT=100
